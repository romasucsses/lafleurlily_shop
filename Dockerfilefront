# Build Stage for Vue Lily
FROM node:22-alpine3.19 as build-lily
WORKDIR /vue_lily
COPY /front_vue/package*.json ./
RUN npm install
COPY /front_vue/lily ./lily
RUN npm run build

# Build Stage for Vue DA
FROM node:22-alpine3.19 as build-da
WORKDIR /vue_da
COPY /front_vue/package*.json ./
RUN npm install
COPY /front_vue/da ./da
RUN npm run build

# Build Stage for Vue Bastina
FROM node:22-alpine3.19 as build-bastina
WORKDIR /vue_bastina
COPY /front_vue/package*.json ./
RUN npm install
COPY /front_vue/bastina ./bastina
RUN npm run build

# Stage 2: Serve Built Files Using Nginx
FROM nginx:1.26-alpine as production

# Install Certbot for SSL
RUN apk update && \
    apk add --no-cache certbot certbot-nginx

# Create directories for Certbot challenges
RUN mkdir -p /var/www/certbot

# Copy custom Nginx configuration files
COPY app/nginx/nginx.conf /etc/nginx/nginx.conf
COPY app/nginx/conf.d /etc/nginx/conf.d

# Copy built files from each project
COPY --from=build-lily /vue_lily/lily/dist /usr/share/nginx/html/lily
COPY --from=build-da /vue_da/da/dist /usr/share/nginx/html/da
COPY --from=build-bastina /vue_bastina/bastina/dist /usr/share/nginx/html/bastina

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]


